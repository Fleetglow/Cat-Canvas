{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "description": "Cat Canvas 主窗口仅可调用应用自身的桌面命令",
  "windows": ["main"],
  "remote": {
    "urls": ["http://127.0.0.1:*"]
  },
  "permissions": [
    "core:default",
    "allow-backend-status",
    "allow-pick-legacy-folder",
    "allow-skip-legacy-import",
    "allow-import-legacy-data",
    "allow-check-desktop-update",
    "allow-probe-update-source",
    "allow-download-desktop-update",
    "allow-install-desktop-update",
    "allow-save-output-file",
    "allow-open-backup-folder",
    "allow-finish-desktop-close",
    "allow-cancel-desktop-close"
  ]
}
